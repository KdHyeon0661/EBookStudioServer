# GitHub Container Registry namespace, for example ghcr.io/your-github-name
IMAGE_PREFIX=ghcr.io/your-github-name
IMAGE_TAG=latest

# Bind to 127.0.0.1 when TLS is terminated by a reverse proxy on this host.
# Use 0.0.0.0 only when the API must be reached directly from another device.
API_BIND_ADDRESS=127.0.0.1
API_PORT=5000

# Required for stable JWT signatures. Replace before starting the service.
SECRET_KEY=replace-with-at-least-64-random-characters
ACCESS_TOKEN_SECONDS=3600
REFRESH_TOKEN_SECONDS=604800

API_MEMORY_LIMIT=768m
ANALYSIS_MEMORY_LIMIT=2g
MUSIC_MEMORY_LIMIT=16g

EMAIL_DELIVERY_ENABLED=false
EMAIL_EXPOSE_DEVELOPMENT_CODE=false
EMAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

JOB_STALE_SECONDS=900
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
MUSIC_GENERATOR_VERSION=facebook/musicgen-small:v1

