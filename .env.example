# Spring service data uses PostgreSQL; Spring and Python share only the SQLite job queue.
POSTGRES_DB=ebookstudio
POSTGRES_USER=ebookstudio
POSTGRES_PASSWORD=ebookstudio-local
EBOOK_QUEUE_DB_PATH=C:/ebookstudio/data/jobs.db
EBOOK_STORAGE_ROOT=C:/ebookstudio/data
SERVER_PORT=5000

# Docker Compose image, port, and local resource limits
IMAGE_TAG=local
API_PORT=5000
API_MEMORY_LIMIT=768m
ANALYSIS_MEMORY_LIMIT=2g
MUSIC_MEMORY_LIMIT=16g

# Optional: when omitted, Spring creates EBOOK_STORAGE_ROOT/.jwt-secret.
SECRET_KEY=

# Safe defaults: codes are neither sent nor exposed.
# Local demo only: set EMAIL_EXPOSE_DEVELOPMENT_CODE=true.
# Production: set EMAIL_DELIVERY_ENABLED=true and configure SMTP; keep exposure false.
EMAIL_DELIVERY_ENABLED=false
EMAIL_EXPOSE_DEVELOPMENT_CODE=false
EMAIL_FROM=noreply@example.com

# Authentication request limits (per window)
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
VERIFICATION_IP_LIMIT=20
VERIFICATION_EMAIL_LIMIT=5
VERIFICATION_RATE_WINDOW_SECONDS=3600

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Worker recovery
JOB_STALE_SECONDS=900
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3

# Bump this whenever the music model or generation algorithm changes.
MUSIC_GENERATOR_VERSION=facebook/musicgen-small:v1

# WPF client
EBOOK_API_BASE_URL=http://127.0.0.1:5000